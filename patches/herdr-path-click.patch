+++ b/src/server/headless/desktop_routing.rs
@@ -0,0 +1,307 @@
+//! Desktop operations have a connection owner, never a session-wide destination.
+use crate::api::schema::DesktopClientContext;
+use crate::layout::PaneId;
+use crate::protocol::{ClientKeyCode, ClientKeyKind, ClientPaneInputEvent};
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+const REQUEST_TTL: Duration = Duration::from_secs(5);
+
+#[derive(Default)]
+pub(super) struct DesktopRoutes {
+    pub contexts: HashMap<u64, DesktopClientContext>,
+    pending: HashMap<(String, String), (Option<u64>, Instant)>,
+    pub owners: HashMap<PaneId, (String, u64)>,
+}
+
+impl DesktopRoutes {
+    pub fn note_input(
+        &mut self,
+        pane: &str,
+        runtime: PaneId,
+        client: u64,
+        events: &[ClientPaneInputEvent],
+        now: Instant,
+    ) {
+        for event in events {
+            if matches!(
+                event,
+                ClientPaneInputEvent::Key {
+                    kind: ClientKeyKind::Press | ClientKeyKind::Repeat,
+                    ..
+                } | ClientPaneInputEvent::TextCommit(_)
+                    | ClientPaneInputEvent::Paste(_)
+            ) {
+                self.owners.insert(runtime, (pane.to_owned(), client));
+            }
+            let action = match event {
+                ClientPaneInputEvent::Key {
+                    code: ClientKeyCode::Char('g'),
+                    modifiers,
+                    kind: ClientKeyKind::Press,
+                    ..
+                } if *modifiers == crossterm::event::KeyModifiers::CONTROL.bits() => Some("drag"),
+                ClientPaneInputEvent::Key {
+                    code: ClientKeyCode::Enter,
+                    modifiers: 0,
+                    kind: ClientKeyKind::Press,
+                    ..
+                } => Some("open"),
+                _ => None,
+            };
+            if let Some(action) = action {
+                let key = (pane.to_owned(), action.to_owned());
+                let owner = match self.pending.get(&key) {
+                    Some((previous_owner, previous))
+                        if *previous_owner != Some(client)
+                            && now.duration_since(*previous) < REQUEST_TTL =>
+                    {
+                        None
+                    }
+                    _ => Some(client),
+                };
+                self.pending.insert(key, (owner, now));
+            }
+        }
+    }
+
+    pub fn take(
+        &mut self,
+        pane: &str,
+        action: &str,
+        now: Instant,
+    ) -> Result<DesktopClientContext, &'static str> {
+        let (owner, when) = self
+            .pending
+            .remove(&(pane.to_owned(), action.to_owned()))
+            .ok_or("Use the Herdr client key; no matching desktop request belongs to this pane")?;
+        if now.duration_since(when) >= REQUEST_TTL {
+            return Err("Desktop request expired; press Ctrl+G again");
+        }
+        let owner = owner.ok_or("Overlapping Ctrl+G requests; wait and press Ctrl+G once")?;
+        self.contexts
+            .get(&owner)
+            .cloned()
+            .ok_or("Originating client disconnected or lacks desktop routing; reconnect herdr-yazi")
+    }
+
+    pub fn clipboard_owner(&self, pane: PaneId) -> Option<u64> {
+        self.owners.get(&pane).map(|(_, client)| *client)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn context(local: bool) -> DesktopClientContext {
+        DesktopClientContext {
+            link: crate::api::schema::LinkClientContext {
+                local_to_server: local,
+                desktop_env: Default::default(),
+            },
+            receiver_id: Some(format!("receiver-{local}")),
+        }
+    }
+    fn ctrl_g() -> ClientPaneInputEvent {
+        ClientPaneInputEvent::from_terminal_key(
+            crossterm::event::KeyEvent::new(
+                crossterm::event::KeyCode::Char('g'),
+                crossterm::event::KeyModifiers::CONTROL,
+            )
+            .into(),
+        )
+        .unwrap()
+    }
+    #[test]
+    fn request_keeps_origin_when_another_client_types_and_cannot_be_replayed() {
+        let mut routes = DesktopRoutes::default();
+        routes.contexts.insert(1, context(true));
+        routes.contexts.insert(2, context(false));
+        let pane = PaneId::alloc();
+        let now = Instant::now();
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        routes.note_input(
+            "w1:p1",
+            pane,
+            2,
+            &[ClientPaneInputEvent::Paste("elsewhere".into())],
+            now,
+        );
+        assert_eq!(routes.take("w1:p1", "drag", now).unwrap(), context(true));
+        assert!(routes.take("w1:p1", "drag", now).is_err());
+        routes.note_input("w1:p1", pane, 2, &[ctrl_g()], now);
+        assert_eq!(routes.take("w1:p1", "drag", now).unwrap(), context(false));
+    }
+    #[test]
+    fn disconnected_expired_and_overlapping_requests_never_fall_back() {
+        let mut routes = DesktopRoutes::default();
+        let pane = PaneId::alloc();
+        let now = Instant::now();
+        routes.contexts.insert(1, context(true));
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        routes.contexts.remove(&1);
+        assert!(routes.take("w1:p1", "drag", now).is_err());
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        assert!(routes.take("w1:p1", "drag", now + REQUEST_TTL).is_err());
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        routes.note_input("w1:p1", pane, 2, &[ctrl_g()], now);
+        assert!(routes.take("w1:p1", "drag", now).is_err());
+    }
+    fn enter() -> ClientPaneInputEvent {
+        ClientPaneInputEvent::from_terminal_key(
+            crossterm::event::KeyEvent::new(
+                crossterm::event::KeyCode::Enter,
+                crossterm::event::KeyModifiers::NONE,
+            )
+            .into(),
+        )
+        .unwrap()
+    }
+
+    fn ready() -> (DesktopRoutes, PaneId, Instant) {
+        let mut routes = DesktopRoutes::default();
+        routes.contexts.insert(1, context(true));
+        routes.contexts.insert(2, context(false));
+        (routes, PaneId::alloc(), Instant::now())
+    }
+
+    #[test]
+    fn drag_and_open_requests_do_not_consume_each_other() {
+        let (mut routes, pane, now) = ready();
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        routes.note_input("w1:p1", pane, 2, &[enter()], now);
+        assert_eq!(routes.take("w1:p1", "open", now).unwrap(), context(false));
+        assert_eq!(routes.take("w1:p1", "drag", now).unwrap(), context(true));
+        assert!(routes.take("w1:p1", "open", now).is_err());
+    }
+
+    #[test]
+    fn requests_are_isolated_between_panes_and_workspaces() {
+        let (mut routes, pane, now) = ready();
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        routes.note_input("w2:p1", PaneId::alloc(), 2, &[ctrl_g()], now);
+        assert!(routes.take("w3:p1", "drag", now).is_err());
+        assert_eq!(routes.take("w2:p1", "drag", now).unwrap(), context(false));
+        assert_eq!(routes.take("w1:p1", "drag", now).unwrap(), context(true));
+    }
+
+    #[test]
+    fn wrong_action_does_not_consume_the_valid_request() {
+        let (mut routes, pane, now) = ready();
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        assert!(routes.take("w1:p1", "shell", now).is_err());
+        assert_eq!(routes.take("w1:p1", "drag", now).unwrap(), context(true));
+    }
+
+    #[test]
+    fn request_is_valid_before_ttl_and_expires_exactly_at_boundary() {
+        for delay in [REQUEST_TTL - Duration::from_nanos(1), REQUEST_TTL] {
+            let (mut routes, pane, now) = ready();
+            routes.note_input("w1:p1", pane, 1, &[enter()], now);
+            assert_eq!(
+                routes.take("w1:p1", "open", now + delay).is_ok(),
+                delay < REQUEST_TTL
+            );
+            assert!(routes.take("w1:p1", "open", now + delay).is_err());
+        }
+    }
+
+    #[test]
+    fn overlapping_open_and_drag_fail_once_then_accept_a_fresh_request() {
+        for (action, event) in [("drag", ctrl_g()), ("open", enter())] {
+            let (mut routes, pane, now) = ready();
+            routes.note_input("w1:p1", pane, 1, std::slice::from_ref(&event), now);
+            routes.note_input("w1:p1", pane, 2, std::slice::from_ref(&event), now);
+            assert!(routes.take("w1:p1", action, now).is_err());
+            assert!(routes.take("w1:p1", action, now).is_err());
+            routes.note_input("w1:p1", pane, 2, &[event], now);
+            assert_eq!(routes.take("w1:p1", action, now).unwrap(), context(false));
+        }
+    }
+
+    #[test]
+    fn expired_other_client_request_does_not_block_new_client() {
+        let (mut routes, pane, now) = ready();
+        routes.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        routes.note_input("w1:p1", pane, 2, &[ctrl_g()], now + REQUEST_TTL);
+        assert_eq!(
+            routes.take("w1:p1", "drag", now + REQUEST_TTL).unwrap(),
+            context(false)
+        );
+    }
+
+    #[test]
+    fn reconnect_with_a_new_connection_cannot_claim_old_connection_request() {
+        let (mut routes, pane, now) = ready();
+        routes.note_input("w1:p1", pane, 2, &[ctrl_g()], now);
+        let old = routes.contexts.remove(&2).unwrap();
+        routes.contexts.insert(3, old);
+        assert!(routes.take("w1:p1", "drag", now).is_err());
+        routes.note_input("w1:p1", pane, 3, &[ctrl_g()], now);
+        assert_eq!(routes.take("w1:p1", "drag", now).unwrap(), context(false));
+    }
+
+    #[test]
+    fn unregistered_client_cannot_borrow_another_context() {
+        let (mut routes, pane, now) = ready();
+        routes.note_input("w1:p1", pane, 99, &[ctrl_g()], now);
+        assert!(routes.take("w1:p1", "drag", now).is_err());
+    }
+
+    #[test]
+    fn release_repeat_and_modified_keys_do_not_authorize_desktop_actions() {
+        for kind in [ClientKeyKind::Release, ClientKeyKind::Repeat] {
+            let (mut routes, pane, now) = ready();
+            let mut key = ctrl_g();
+            if let ClientPaneInputEvent::Key { kind: value, .. } = &mut key {
+                *value = kind;
+            }
+            routes.note_input("w1:p1", pane, 1, &[key], now);
+            assert!(routes.take("w1:p1", "drag", now).is_err());
+        }
+        for mut key in [ctrl_g(), enter()] {
+            let (mut routes, pane, now) = ready();
+            if let ClientPaneInputEvent::Key { modifiers, .. } = &mut key {
+                *modifiers |= crossterm::event::KeyModifiers::SHIFT.bits();
+            }
+            routes.note_input("w1:p1", pane, 1, &[key], now);
+            assert!(routes.take("w1:p1", "drag", now).is_err());
+            assert!(routes.take("w1:p1", "open", now).is_err());
+        }
+    }
+
+    #[test]
+    fn clipboard_ownership_is_per_pane_and_paste_does_not_authorize_gui() {
+        let (mut routes, pane, now) = ready();
+        let other = PaneId::alloc();
+        routes.note_input(
+            "w1:p1",
+            pane,
+            1,
+            &[ClientPaneInputEvent::Paste("text".into())],
+            now,
+        );
+        routes.note_input(
+            "w1:p2",
+            other,
+            2,
+            &[ClientPaneInputEvent::TextCommit("text".into())],
+            now,
+        );
+        assert_eq!(routes.clipboard_owner(pane), Some(1));
+        assert_eq!(routes.clipboard_owner(other), Some(2));
+        assert_eq!(routes.clipboard_owner(PaneId::alloc()), None);
+        assert!(routes.take("w1:p1", "drag", now).is_err());
+        assert!(routes.take("w1:p2", "open", now).is_err());
+    }
+
+    #[test]
+    fn new_server_boot_has_no_persisted_desktop_identity() {
+        let (mut old, pane, now) = ready();
+        old.note_input("w1:p1", pane, 1, &[ctrl_g()], now);
+        let mut new = DesktopRoutes::default();
+        assert!(new.contexts.is_empty());
+        assert_eq!(new.clipboard_owner(pane), None);
+        assert!(new.take("w1:p1", "drag", now).is_err());
+    }
+}
