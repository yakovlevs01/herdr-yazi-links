+// Keep this scoped to the invoking client, never the server's process environment.
+fn link_client_context(
+    local_to_server: bool,
+    env: impl Fn(&str) -> Option<String>,
+) -> crate::api::schema::LinkClientContext {
+    let keys = [
+        "DISPLAY",
+        "WAYLAND_DISPLAY",
+        "XAUTHORITY",
+        "XDG_RUNTIME_DIR",
+        "DBUS_SESSION_BUS_ADDRESS",
+        "XDG_CURRENT_DESKTOP",
+        "XDG_SESSION_TYPE",
+    ];
+    crate::api::schema::LinkClientContext {
+        local_to_server,
+        desktop_env: if local_to_server {
+            keys.into_iter()
+                .filter_map(|key| {
+                    env(key)
+                        .filter(|value| !value.is_empty())
+                        .map(|value| (key.to_string(), value))
+                })
+                .collect()
+        } else {
+            Default::default()
+        },
+    }
+}
