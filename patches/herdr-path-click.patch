+}
+
+pub(super) fn url_from_link_target_with_cwd(
+    target: crate::ghostty::LinkTarget,
+    cwd: impl FnOnce() -> Option<std::path::PathBuf>,
+) -> Option<String> {
     match target {
         crate::ghostty::LinkTarget::Uri(uri) => Some(uri),
         crate::ghostty::LinkTarget::Text { text, clicked_byte } => {
-            url_at_byte(&text, clicked_byte).map(str::to_owned)
+            url_at_byte(&text, clicked_byte)
+                .map(str::to_owned)
+                .or_else(|| {
+                    // Resolve only on activation, on the server owning the pane.
+                    // Hover and rendering must never perform filesystem I/O.
+                    file_url_at_byte(&text, clicked_byte, &cwd()?)
+                })
         }
     }
 }
 
+fn file_url_at_byte(row: &str, clicked_byte: usize, cwd: &std::path::Path) -> Option<String> {
+    let cells = text_cells(row);
+    let clicked_idx = row.get(..clicked_byte)?.chars().count();
+    cells.get(clicked_idx)?;
+    let span = quoted_path_span_at_column(&cells, clicked_idx)
+        .or_else(|| token_span_at_column(&cells, clicked_idx))?;
+    let token =
+        row.get(byte_index_for_cell(row, span.start)..byte_index_after_cell(row, span.end))?;
+    // Do not reinterpret URI schemes or line/column suffixes as filesystem paths.
+    if token.contains(':') || token.chars().any(char::is_control) {
+        return None;
+    }
+    let home = std::env::home_dir();
+    let path = resolve_file_link_path(token, cwd, home.as_deref())?;
+    if !path.is_file() && !path.is_dir() {
+        return None;
+    }
+    let mut uri = String::from("file://");
+    for byte in path.to_str()?.bytes() {
+        if byte.is_ascii_alphanumeric() || b"/-._~".contains(&byte) {
+            uri.push(char::from(byte));
+        } else {
+            use std::fmt::Write;
+            write!(uri, "%{byte:02X}").ok()?;
+        }
+    }
+    Some(uri)
+}
+
+fn resolve_file_link_path(
+    token: &str,
+    cwd: &std::path::Path,
+    home: Option<&std::path::Path>,
+) -> Option<std::path::PathBuf> {
+    if let Some(rest) = token.strip_prefix("~/") {
+        // Resolve on the pane's server, never relative to the pane cwd.
+        let home = home.filter(|path| path.is_absolute())?;
+        return Some(home.join(rest.trim_start_matches('/')));
+    }
+    let path = std::path::Path::new(token);
+    Some(if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        cwd.join(path)
+    })
+}
