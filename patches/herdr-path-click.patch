+    use super::link_client_context;
+
+    #[test]
+    fn local_click_carries_only_desktop_variables() {
+        let context = link_client_context(true, |key| Some(format!("value-of-{key}")));
+        assert!(context.local_to_server);
+        assert_eq!(context.desktop_env.len(), 7);
+        assert_eq!(context.desktop_env["DISPLAY"], "value-of-DISPLAY");
+        assert!(!context.desktop_env.contains_key("PATH"));
+    }
+
+    #[test]
+    fn remote_click_never_reads_or_forwards_local_environment() {
+        let context = link_client_context(false, |_| panic!("must not read local environment"));
+        assert!(!context.local_to_server);
+        assert!(context.desktop_env.is_empty());
+    }
+
+    #[test]
+    fn local_tty_is_explicitly_distinct_from_legacy_missing_context() {
+        let context = link_client_context(true, |_| None);
+        assert!(context.local_to_server);
+        assert!(context.desktop_env.is_empty());
+    }
+}
