 mod tests;
+
+/// Desktop belongs to this client process, not the persistent server.
+pub(crate) fn desktop_context(local_endpoint: bool) -> crate::api::schema::DesktopClientContext {
+    let local = local_endpoint && !is_remote_client_process() && !is_ssh_session();
+    let desktop_env = if local {
+        [
+            "DISPLAY",
+            "WAYLAND_DISPLAY",
+            "XAUTHORITY",
+            "XDG_RUNTIME_DIR",
+            "DBUS_SESSION_BUS_ADDRESS",
+            "XDG_CURRENT_DESKTOP",
+            "XDG_SESSION_TYPE",
+        ]
+        .into_iter()
+        .filter_map(|key| std::env::var(key).ok().map(|v| (key.to_owned(), v)))
+        .collect()
+    } else {
+        Default::default()
+    };
+    crate::api::schema::DesktopClientContext {
+        link: crate::api::schema::LinkClientContext {
+            local_to_server: local,
+            desktop_env,
+        },
+        receiver_id: if is_ssh_session() {
+            None
+        } else {
+            std::env::var("HERDR_DRAG_RECEIVER_ID").ok()
+        },
+    }
+}
+
+fn register_desktop_before_input(
+    endpoints: &mut endpoint::EndpointRegistry,
+    shell: Option<&shell::ClientShellState>,
+) {
+    let id = endpoints.active_id().clone();
+    let Some(connection) = endpoints.connection(&id) else {
+        return;
+    };
+    if connection.desktop_registered
+        || !connection
+            .negotiation
+            .supports_method("client.desktop.register")
+    {
+        return;
+    }
+    let Some(boot) = shell.and_then(|s| s.endpoint_boot_id(&id)) else {
+        return;
+    };
+    let request = crate::api::schema::Request {
+        id: "client-desktop-input".into(),
+        method: crate::api::schema::Method::ClientDesktopRegister(desktop_context(id.is_local())),
+    };
+    if let Ok(request) = serde_json::to_string(&request) {
+        if endpoints.send_to(
+            &id,
+            &ClientMessage::ClientShellEndpointRequest {
+                boot_id: boot.into(),
+                request,
+            },
+        ) == endpoint::EndpointSendOutcome::Sent
+        {
+            endpoints.mark_desktop_registered(&id);
+        }
+    }
+}
