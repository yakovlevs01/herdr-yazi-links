+use super::*;
+
+fn add_client(
+    server: &mut HeadlessServer,
+    id: u64,
+    active: bool,
+) -> std::sync::mpsc::Receiver<Vec<u8>> {
+    let (writer, rx, _render) = test_client_writer();
+    let mut client = ClientConnection::new_with_mode(
+        ClientConnectionMode::ClientShell,
+        (80, 24),
+        crate::kitty_graphics::HostCellSize::default(),
+        id,
+        RenderEncoding::SemanticFrame,
+        Some(writer),
+    );
+    client.shell_surface_active = active;
+    server.clients.insert(id, client);
+    rx
+}
+
+fn context(receiver: &str) -> api::schema::DesktopClientContext {
+    api::schema::DesktopClientContext {
+        link: api::schema::LinkClientContext {
+            local_to_server: false,
+            desktop_env: Default::default(),
+        },
+        receiver_id: Some(receiver.into()),
+    }
+}
+
+fn register(server: &mut HeadlessServer, client_id: u64, boot_id: String, receiver: &str) {
+    server.handle_server_event(ServerEvent::ClientShellEndpointRequest {
+        client_id,
+        boot_id,
+        request: Box::new(api::schema::Request {
+            id: "desktop-test".into(),
+            method: api::schema::Method::ClientDesktopRegister(context(receiver)),
+        }),
+    });
+}
+
+#[test]
+fn desktop_registration_is_owned_by_actual_connection_including_inactive_endpoints() {
+    let mut server = test_headless_server();
+    let _a = add_client(&mut server, 1, true);
+    let _b = add_client(&mut server, 2, false);
+    let boot = server.client_shell_boot_id.clone();
+    register(&mut server, 1, boot.clone(), "mac");
+    register(&mut server, 2, boot, "iw");
+    assert_eq!(
+        server.desktop_routes.contexts.get(&1),
+        Some(&context("mac"))
+    );
+    assert_eq!(server.desktop_routes.contexts.get(&2), Some(&context("iw")));
+    server.remove_client(1);
+    assert!(!server.desktop_routes.contexts.contains_key(&1));
+    assert_eq!(server.desktop_routes.contexts.get(&2), Some(&context("iw")));
+}
+
+#[test]
+fn desktop_registration_from_old_boot_cannot_replace_current_context() {
+    let mut server = test_headless_server();
+    let _rx = add_client(&mut server, 1, true);
+    let boot = server.client_shell_boot_id.clone();
+    register(&mut server, 1, boot, "current");
+    register(&mut server, 1, "old-boot".into(), "stale");
+    assert_eq!(
+        server.desktop_routes.contexts.get(&1),
+        Some(&context("current"))
+    );
+    assert!(server.clients.contains_key(&1));
+    let boot = server.client_shell_boot_id.clone();
+    register(&mut server, 99, boot, "unknown");
+    assert!(!server.desktop_routes.contexts.contains_key(&99));
+}
+
+fn clipboard_fixture() -> (HeadlessServer, crate::layout::PaneId) {
+    let mut server = test_headless_server();
+    server.app.state.workspaces = vec![crate::workspace::Workspace::test_new("clipboard")];
+    server.app.state.ensure_test_terminals();
+    server.app.state.active = Some(0);
+    let pane = server.app.state.workspaces[0].tabs[0].layout.focused();
+    let public = server.app.public_pane_id(0, pane).unwrap();
+    server.desktop_routes.owners.insert(pane, (public, 1));
+    (server, pane)
+}
+
+fn copy(server: &mut HeadlessServer, pane_id: crate::layout::PaneId) {
+    server.handle_internal_event_with_forwarding(AppEvent::ClipboardWrite {
+        pane_id,
+        content: b"test".to_vec(),
+    });
+}
+
+fn copied(rx: &std::sync::mpsc::Receiver<Vec<u8>>) -> Vec<String> {
+    std::iter::from_fn(|| rx.recv_timeout(Duration::from_millis(100)).ok())
+        .filter_map(|data| match read_server_message(data) {
+            ServerMessage::Clipboard { data } => Some(data),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn clipboard_shared_active_pane_is_refused_then_works_after_disconnect() {
+    let (mut server, pane) = clipboard_fixture();
+    let a = add_client(&mut server, 1, true);
+    let b = add_client(&mut server, 2, true);
+    copy(&mut server, pane);
+    assert!(copied(&a).is_empty());
+    assert!(copied(&b).is_empty());
+    server.remove_client(2);
+    copy(&mut server, pane);
+    assert_eq!(copied(&a), ["dGVzdA=="]);
+}
+
+#[test]
+fn clipboard_inactive_saved_machine_endpoint_does_not_block_active_owner() {
+    let (mut server, pane) = clipboard_fixture();
+    let a = add_client(&mut server, 1, true);
+    let b = add_client(&mut server, 2, false);
+    copy(&mut server, pane);
+    assert_eq!(copied(&a), ["dGVzdA=="]);
+    assert!(copied(&b).is_empty());
+}
+
+#[test]
+fn clipboard_disconnected_owner_never_falls_back_to_remaining_viewer() {
+    let (mut server, pane) = clipboard_fixture();
+    let a = add_client(&mut server, 1, true);
+    let b = add_client(&mut server, 2, true);
+    server.remove_client(1);
+    copy(&mut server, pane);
+    assert!(copied(&a).is_empty());
+    assert!(copied(&b).is_empty());
+}
