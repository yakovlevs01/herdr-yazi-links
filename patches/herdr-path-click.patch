+    #[test]
+    fn file_links_resolve_existing_absolute_relative_and_unicode_paths() {
+        let root = std::env::temp_dir().join(format!(
+            "herdr-file-links-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let dir = root.join("src");
+        std::fs::create_dir(&dir).unwrap();
+        let file = dir.join("отчёт.rs");
+        std::fs::write(&file, "example").unwrap();
+        std::fs::write(root.join("README.md"), "example").unwrap();
+        for token in [
+            "src/отчёт.rs",
+            "./src/отчёт.rs",
+            "README.md",
+            "src",
+            file.to_str().unwrap(),
+        ] {
+            let row = format!("Изменён `{token}`, готово.");
+            let result = file_url_at_byte(&row, row.find(token).unwrap(), &root).unwrap();
+            assert!(result.starts_with("file:///"), "{result}");
+            assert!(!result.contains('`'));
+            if token.contains("отчёт") {
+                assert!(result.ends_with("%D0%BE%D1%82%D1%87%D1%91%D1%82.rs"));
+            }
+        }
+        assert!(file_url_at_byte("../README.md", 3, &dir).is_some());
+        assert!(file_url_at_byte("README.md", 0, &dir).is_none());
+        for row in [
+            "missing.rs",
+            "https://example.com/README.md",
+            "README.md:12:3",
+            " ",
+        ] {
+            assert_eq!(file_url_at_byte(row, 0, &root), None, "{row}");
+        }
+    }
+
+    #[test]
+    fn file_links_use_terminal_byte_offsets_and_preserve_uri_priority() {
+        use crate::ghostty::LinkTarget;
+        let root = std::env::temp_dir().join(format!("herdr-byte-links-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        std::fs::write(root.join("отчёт.txt"), "test").unwrap();
+        let row = "界 e\u{301} `отчёт.txt`";
+        let clicked_byte = row.find("чёт").unwrap();
+        let target = LinkTarget::Text {
+            text: row.into(),
+            clicked_byte,
+        };
+        let uri = url_from_link_target_with_cwd(target, || Some(root.clone())).unwrap();
+        assert!(uri.ends_with("%D0%BE%D1%82%D1%87%D1%91%D1%82.txt"));
+        assert!(file_url_at_byte(row, clicked_byte + 1, &root).is_none());
+        assert!(file_url_at_byte(row, row.len(), &root).is_none());
+        for target in [
+            LinkTarget::Uri("file:///explicit.txt".into()),
+            LinkTarget::Text {
+                text: "https://example.com/path".into(),
+                clicked_byte: 8,
+            },
+        ] {
+            assert!(
+                url_from_link_target_with_cwd(target, || panic!("URI must not resolve cwd"))
+                    .is_some()
+            );
+        }
+    }
+
+    #[test]
+    fn file_links_expand_home_only_for_tilde_slash() {
+        use std::path::Path;
+        let cwd = Path::new("/work/project");
+        let home = Some(Path::new("/home/tester"));
+        for (token, expected) in [
+            ("~/README.md", "/home/tester/README.md"),
+            ("~/", "/home/tester/"),
+            ("~//README.md", "/home/tester/README.md"),
+            ("~/my files/отчёт.rs", "/home/tester/my files/отчёт.rs"),
+            ("README.md", "/work/project/README.md"),
+            ("/tmp/README.md", "/tmp/README.md"),
+            ("~someone/README.md", "/work/project/~someone/README.md"),
+        ] {
+            assert_eq!(
+                resolve_file_link_path(token, cwd, home).as_deref(),
+                Some(Path::new(expected))
+            );
+        }
+        assert!(resolve_file_link_path("~/README.md", cwd, None).is_none());
+        assert!(resolve_file_link_path("~/README.md", cwd, Some(Path::new("relative"))).is_none());
+        assert_eq!(
+            resolve_file_link_path("README.md", cwd, None).unwrap(),
+            cwd.join("README.md")
+        );
+    }
