#!/usr/bin/env python3
"""Yazi's desktop opener; the actual action follows the Enter key's client."""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from drag import submit, watch
try:
    if len(sys.argv) < 2:
        raise ValueError('No file selected')
    result = submit(sys.argv[1:], action='open')
    if result.get('id'):
        for status in watch(result['id'], session=result['scope']):
            if status['state'] in ('error', 'cancelled'):
                raise RuntimeError(status.get('message', status['state']))
except Exception as error:
    print('Herdr desktop: ' + str(error), file=sys.stderr)
    sys.exit(1)
